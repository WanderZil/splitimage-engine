    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WanderZil/splitimage-engine.git"
  },
  "bugs": {
    "url": "https://github.com/WanderZil/splitimage-engine/issues"
  }
