{
  "name": "@splitimage/engine",
  "version": "0.1.0",
  "description": "UI-free image splitting, crop geometry, cover padding, seam detection and ZIP export.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://splitimage.io/",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
